# ─── Backend (set these as Cloud Run env vars or Secret Manager) ───

# Database - Cloud SQL connection string
DATABASE_URL=postgresql://dataportal:PASSWORD@/data_portal?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Security - generate with: openssl rand -hex 32
SECRET_KEY=your-secure-secret-key-here

# AI
GEMINI_API_KEY=your-gemini-api-key

# Firecrawl VM (your existing VM IP)
FIRECRAWL_VM_IP=your-vm-ip
FIRECRAWL_BASE_URL=http://your-vm-ip:3002

# CORS - set to your frontend Cloud Run URL after first deploy
# e.g. https://data-portal-frontend-xyz-uc.a.run.app
ALLOWED_ORIGINS=https://data-portal-frontend-xyz-uc.a.run.app

# GCP
GCP_PROJECT_ID=uniapply-486919
GCP_ZONE=me-central1-b
FIRECRAWL_VM_NAME=firecrawl

# ─── Frontend (set at build time via Cloud Build args) ───

# Backend Cloud Run URL after first backend deploy
NEXT_PUBLIC_API_URL=https://data-portal-backend-xyz-uc.a.run.app
