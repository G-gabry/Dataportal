# Database - Cloud SQL (Google Cloud)
POSTGRES_USER=dataportal
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=data_portal
POSTGRES_HOST=your-cloud-sql-ip
POSTGRES_PORT=5432

# Backend
SECRET_KEY=your-secret-key-change-in-production
# For Cloud SQL: postgresql://user:password@cloud-sql-ip:5432/database
# For Local Docker: postgresql://dataportal:dataportal123@db:5432/dataportal
DATABASE_URL=postgresql://dataportal:your-password@your-cloud-sql-ip:5432/data_portal

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Default AI Settings
DEFAULT_AI_PROVIDER=anthropic
DEFAULT_AI_MODEL=claude-3-5-haiku-20241022

# Firecrawl
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_BASE_URL=http://localhost:3002

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
