# Database - Cloud SQL (Google Cloud)
POSTGRES_USER=dataportal
POSTGRES_PASSWORD=DataPortal2024
POSTGRES_DB=data_portal
POSTGRES_HOST=34.18.45.84 	
POSTGRES_PORT=5432

# Backend
SECRET_KEY=your-secret-key-change-in-production
# For Cloud SQL: postgresql://user:password@cloud-sql-ip:5432/database
# For Local Docker: postgresql://dataportal:dataportal123@db:5432/dataportal
DATABASE_URL=postgresql://dataportal:your-password@your-cloud-sql-ip:5432/data_portal

# AI Providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=AIzaSyAGO994FBa2zpKIOov_laUIHMKJ0cs4Gyw
OPENAI_API_KEY=your-openai-api-key

# Default AI Settings
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.0-flash

# VM Services Configuration (both Firecrawl + Crawl4AI run on the same VM)
# Leave FIRECRAWL_API_KEY empty for self-hosted (no auth needed)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=http://your-vm-ip:3002
# Crawl4AI runs on the same VM, default port 11235
CRAWL4AI_BASE_URL=http://34.18.85.76:11235
# Fallback IP when GCP API is unavailable
FIRECRAWL_VM_IP=34.18.85.76

# GCP Configuration (for dynamic VM IP lookup)
GCP_PROJECT_ID=uniapply-486919
GCP_ZONE=me-central1-a
FIRECRAWL_VM_NAME=firecrawl
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Scholarship Pipeline ──────────────────────────────────────────────────────
# Optional: bearer token if your portal API requires auth for /api/v1/sources
PORTAL_API_TOKEN=

# Where the pipeline finds the backend API (only needed when running OUTSIDE Docker)
# Inside Docker, docker-compose sets PORTAL_API_BASE=http://backend:8000 automatically
PORTAL_API_BASE=http://localhost:8001

# Pipeline reads GEMINI_API_KEY + FIRECRAWL_BASE_URL + CRAWL4AI_BASE_URL from the vars above.
